    {
      "id": 25,
      "type": "table",
      "title": "🚨 Alertas para el planner",
      "description": "Cancelaciones y catering vienen del procesador; colados y sobrecupo se calculan con SQL",
      "gridPos": {
        "x": 0,
        "y": 37,
        "w": 10,
        "h": 11
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-redshift-datasource",
            "uid": "rs"
          },
          "rawSQL": "SELECT hora, quien, alerta FROM ( SELECT ts AS hora, invitado_id || ' · ' || COALESCE(nombre, '') AS quien, motivo_alerta AS alerta FROM v_eventos_actual WHERE alerta AND motivo_alerta <> 'canceló' UNION ALL SELECT hora_llegada, invitado_id || ' · ' || nombre, 'llegó sin estar confirmado (' || estado || ')' FROM v_invitados_actual WHERE llego AND estado <> 'confirmado' UNION ALL SELECT MAX(rsvp_ts), 'Mesa ' || CAST(mesa AS VARCHAR), 'sobrecupo: ' || CAST(COUNT(*) AS VARCHAR) || ' personas para 10 lugares' FROM v_invitados_actual WHERE estado = 'confirmado' AND mesa IS NOT NULL GROUP BY mesa HAVING COUNT(*) > 10 ) a ORDER BY hora DESC LIMIT 40",
          "format": 1,
          "fillMode": {
            "mode": 0
          }
        }
      ],
